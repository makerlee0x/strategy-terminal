# Copy to .env.local. Every value is optional unless noted.
STRATEGY_METRICS_URL=            # upstream metrics endpoint (default: stocktokenswap /api/strategy-metrics)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=   # optional; defaults to the strategycoin.io Reown project
NEXT_PUBLIC_ROBINHOOD_CHAIN_RPC_URL=    # default https://rpc.mainnet.chain.robinhood.com
COINGECKO_API_KEY=
COINGECKO_PLAN=                  # "demo" or "pro"
MSTR_SHARES_BASIS=               # default 352534000
VERCEL_PREVIEW_PREFIX=           # *.vercel.app preview host prefix allowed by origin check (default "strategy")
KV_REST_API_URL=                 # Vercel KV / Upstash Redis REST URL (STRATEGY daily history); without it, history is placeholder (SAMPLE)
KV_REST_API_TOKEN=               # Vercel KV / Upstash Redis REST token
CRON_SECRET=                     # Vercel Cron sends it as a Bearer token to /api/cron/snapshot
